COMPOSE_PROJECT_NAME=superset

# database configurations (do not modify)
DATABASE_DB=superset
DATABASE_HOST=db
# Make sure you set this to a unique secure random value on production
DATABASE_PASSWORD=<your-secure-database-password>
DATABASE_USER=superset

# database engine specific environment variables
# change the below if you prefer another database engine
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
POSTGRES_DB=superset
POSTGRES_USER=superset
# This will automatically match DATABASE_PASSWORD
POSTGRES_PASSWORD=${DATABASE_PASSWORD}

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379

SUPERSET_LOAD_EXAMPLES=yes
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
# Add your Mapbox API key here if using Mapbox features
MAPBOX_API_KEY=<your-mapbox-api-key>

ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true

# Superset admin credentials - Change these in production!
ADMIN_FIRSTNAME=YourProjectName
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<your-secure-admin-password>
ADMIN_LASTNAME=Admin

# Database connection string - database password should be set above
SQLALCHEMY_DATABASE_URI = "postgresql://superset:${DATABASE_PASSWORD}@db/superset"

# CSRF protection
CSRF_EXEMPT_LIST = []